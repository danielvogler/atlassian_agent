# Copy to .env and fill in. .env is gitignored and must never be committed.
# Both services use a personal access token, sent as:
#   Authorization: Bearer <token>

# Confluence — required by the confluence_* tools.
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_TOKEN=your-personal-access-token

# Jira — required only by the jira_* tools. Leave unset to run Confluence-only.
JIRA_URL=https://jira.example.com
JIRA_TOKEN=your-personal-access-token
